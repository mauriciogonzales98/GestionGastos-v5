{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    // vite/client trae las declaraciones de módulo de los assets que Vite resuelve, `*.css`
    // entre ellas. Va acá y no en un .d.ts suelto porque esta lista está curada a mano: al fijar
    // "types" se apaga la carga automática de @types, así que lo que no esté nombrado no existe.
    // Sin esto, `import './estilos/index.css'` no tiene módulo que lo declare. TypeScript 5 lo
    // dejaba pasar; el 6 lo corta con TS2882.
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["src", "tests", "vite.config.ts"],
  // Las pruebas que miden quedan afuera y tienen su propio tsconfig.navegador.json.
  //
  // **No es prolijidad, es que no entran en el mismo programa** (feature 014, D-12): importar
  // `vitest/browser` reemplaza la interfaz `Assertion` por la suya, de estilo Playwright
  // —`toHaveTextContent` pasa a aceptar `string | number`—, y entonces los 19 usos de
  // `toHaveTextContent(/regex/)` que tienen hoy las pruebas con `@testing-library/jest-dom` dejan
  // de compilar. Los dos juegos de matchers no conviven en un `tsc`; sí conviven en dos.
  "exclude": ["tests/**/*.navegador.test.tsx", "tests/anchos.ts", "tests/setup.navegador.ts"]
}
